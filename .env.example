# --- Lago wallet billing -------------------------------------------------
LAGO_API_URL=
LAGO_API_KEY=
# USD per credit. Must match Node's LAGO_CREDIT_RATE_USD.
LAGO_CREDIT_RATE_USD=
# Lago plan codes for our two slugs. Must match Node.
LAGO_PLAN_CODE_FREE=
LAGO_PLAN_CODE_PAID=
# Org that owns GTWY_PAUTH_KEY — its own traffic is never wallet-billed.
GTWY_PLATFORM_ORG_ID=
# GTWY's cut on top of the provider cost, as a percentage. Must match Node.
GTWY_COMMISSION_PCT=10
# Flat USD charged once per HIT, on top of the cost + commission above. Every
# wallet-billed hit pays one. Empty or 0 disables that fee.
# Standard rate — direct API calls and chatbot hits.
GTWY_HIT_FEE_USD=0.07
# Embed traffic pays its own rate instead.
GTWY_EMBED_HIT_FEE_USD=0.06
