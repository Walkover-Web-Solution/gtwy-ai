CHATBOT_OPTIONS_TEMPLATE_ID=
ENVIRONMENT=LOCAL
QUEUE_CONNECTIONURL=
CONSUMER_STATUS=TRUE
# QUEUE_NAME=AI-MIDDLEWARE-PROD
QUEUE_NAME=LOCAL
PREFETCH_COUNT=40
GCP_CREDENTIALS=
TIMESCALE_SERVICE_URL=
PINECONE_API_KEY=
PINECONE_INDEX=
ADMIN_API_KEY=
PUBLIC_REFERENCEID=
Chatbot_Access_key=
LOG_QUEUE_NAME=AI-Middleware-log-prod
URL=

# --- Lago wallet billing -------------------------------------------------
LAGO_API_URL=
LAGO_API_KEY=
# USD per credit. Must match Node's LAGO_CREDIT_RATE_USD.
LAGO_CREDIT_RATE_USD=
# Lago plan codes for our two slugs. Must match Node.
LAGO_PLAN_CODE_FREE=
LAGO_PLAN_CODE_PAID=
# Org that owns GTWY_PAUTH_KEY — its own traffic is never wallet-billed.
GTWY_PLATFORM_ORG_ID=
# GTWY's cut on top of the provider cost, as a percentage. Must match Node.
GTWY_COMMISSION_PCT=10

# Gtwy_Browser: the self-hosted Steel browsers gtwy drives. Empty disables the tool.
# STEEL_API_URLS is the pool (comma separated); STEEL_API_URL still works for a single host.
# Each host's Chrome takes at most STEEL_MAX_TABS_PER_HOST conversations; 3 is right for a
# 1.5 GB container, raise it only after the hosts get more memory.
STEEL_API_URLS=http://localhost:3001,http://localhost:3002
STEEL_API_URL=
STEEL_MAX_TABS_PER_HOST=3
# Public address of this gateway. Without it the browser live-view link points straight at
# Steel and stops working once that tab closes.
GTWY_PUBLIC_URL=http://localhost:8080
