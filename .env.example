SecretKey=
MONGODB_CONNECTION_URI=
Encreaption_key=
Secret_IV=
Access_key=
MONGODB_DATABASE_NAME=AI_Middleware
CHATBOTSECRETKEY=
TEMPLATE_ID=
ORG_ID=
PROJECT_ID=
RTLAYER_AUTH=
max_workers=150
