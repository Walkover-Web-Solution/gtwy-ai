DB_PASS=
DB_HOST=
SecretKey=
MONGODB_CONNECTION_URI=
Encreaption_key=
Secret_IV=
Access_key=
MONGODB_DATABASE_NAME=AI_Middleware
CHATBOTSECRETKEY=
TEMPLATE_ID=
ORG_ID=
PROJECT_ID=
RTLAYER_AUTH=
max_workers=150
REDIS_URI=redis://localhost:6379
CHATBOT_OPTIONS_TEMPLATE_ID=
ENVIRONMENT=LOCAL
QUEUE_CONNECTIONURL=
CONSUMER_STATUS=TRUE
# QUEUE_NAME=AI-MIDDLEWARE-PROD
QUEUE_NAME=LOCAL
PREFETCH_COUNT=40
GCP_CREDENTIALS=
TIMESCALE_SERVICE_URL=
PINECONE_API_KEY=
PINECONE_INDEX=
ADMIN_API_KEY=
PUBLIC_REFERENCEID=
Chatbot_Access_key=
LOG_QUEUE_NAME=AI-Middleware-log-prod
URL=

# --- Lago wallet billing -------------------------------------------------
LAGO_API_URL=
LAGO_API_KEY=
# USD per credit. Must match Node's LAGO_CREDIT_RATE_USD.
LAGO_CREDIT_RATE_USD=
# Lago plan codes for our two slugs. Must match Node.
LAGO_PLAN_CODE_FREE=
LAGO_PLAN_CODE_PAID=
# Org that owns GTWY_PAUTH_KEY — its own traffic is never wallet-billed.
GTWY_PLATFORM_ORG_ID=
# GTWY's cut on top of the provider cost, as a percentage. Must match Node.
GTWY_COMMISSION_PCT=10

# Gtwy_Browser: one hosted browser per conversation, on the service the agent picks
# (gtwy_browser_settings.provider; Browser Use by default). An empty key turns that service off.
# Use a separate key (and Browserbase project) per environment, and a unique ENVIRONMENT value:
# the reaper stops running browsers tagged with this ENVIRONMENT that no conversation owns
# (Steel has no tags, so a shared Steel key would let one environment see another's browsers).
BROWSER_USE_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
STEEL_API_KEY=
KERNEL_API_KEY=
ANCHOR_API_KEY=
# Public address of this gateway, for the signed live-view link. Without it the chat gets the
# browser's own live URL, which lets anyone holding it control that browser.
GTWY_PUBLIC_URL=http://localhost:8080
