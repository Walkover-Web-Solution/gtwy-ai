# Usage Limits System - Environment Variables

# RabbitMQ Configuration
QUEUE_CONNECTIONURL=amqp://guest:guest@localhost:5672
USAGE_EVENTS_QUEUE_NAME=usage_events
USAGE_EVENTS_FAILED_QUEUE_NAME=usage_events_failed

# Redis Configuration (already configured, verify these)
REDIS_URI=redis://localhost:6379

# TimescaleDB Configuration (already configured, verify these)
DB_HOST=localhost
DB_USER=postgres
DB_PASS=password
DB_NAME=timescale_db
DB_PORT=5432

# MongoDB Configuration (already configured, verify these)
MONGODB_CONNECTION_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=gtwy_db

# Feature Flags (for gradual rollout)
USAGE_LIMITS_ENABLED=false
USAGE_LIMITS_ROLLOUT_PERCENTAGE=0

# Reconciliation Job
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MINUTES=5
RECONCILIATION_THRESHOLD=0.10

# Logging
LOG_LEVEL=INFO
DEBUG_USAGE_LIMITS=false

# Optional: Custom Pricing (if different from defaults)
# CUSTOM_PRICING_CONFIG={"openai": {"gpt-4": {"input": 0.03, "output": 0.06}}}
